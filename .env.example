# Environment Configuration
ENVIRONMENT=production

# Database Configuration
DATABASE_HOST=localhost
DATABASE_NAME=invoicing_system
DATABASE_USER=root
DATABASE_PASS=

# API Configuration
API_BASE_URL=https://inv.kenzastore.my.id/api/index.php
INVOICE_BASE_URL=https://inv.kenzastore.my.id/invoices/

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
CORS_ORIGIN=https://inv.kenzastore.my.id

# Email Configuration (for user registration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Payment Configuration (if needed)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# File Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH=./uploads/

# Debug Mode
DEBUG_MODE=false
LOG_ERRORS=true